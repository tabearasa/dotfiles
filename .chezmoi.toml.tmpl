{{- $github_name := promptStringOnce . "github_name" "github_name" -}}
{{- $github_email := promptStringOnce . "github_email" "github_email" -}}
{{- $git_work_name := promptStringOnce . "git_work_name" "git_work_name" -}}
{{- $work_email := promptStringOnce . "work_email" "work_email" -}}
{{- $company_computer := promptStringOnce . "company_computer" "is_this_your_company_computer_[y/n]" -}}
{{- $keepassxc_db := promptStringOnce . "keepassxc_db" "path_to_keepassxc_database" -}}
{{- $work_git_host := "" -}}
{{- if eq $company_computer "y" -}}
{{-   $work_git_host = promptStringOnce . "work_git_host" "work_git_host_(e.g._github.example.com)" -}}
{{- end -}}
{{- /* Optional apps for personal machines, installed by run_onchange_before_00_install_packages */ -}}
{{- $optional_apps := list "freecad" "blender" "kicad" "darktable" "btop" "brave" -}}
{{- $install := dict -}}
{{- if ne $company_computer "y" -}}
{{-   range $optional_apps -}}
{{-     $key := printf "install_%s" . -}}
{{-     $_ := set $install $key (promptBoolOnce $ $key (printf "install_%s_[y/n]" .)) -}}
{{-   end -}}
{{- end -}}

[edit]
    command = "nvim"

[git]
    autoCommit = true
    autoPush = true

[data]
    github_name = "{{ $github_name }}"
    github_email = "{{ $github_email }}"
    git_work_name = "{{ $git_work_name }}"
    work_email = "{{ $work_email }}"
    company_computer = "{{ $company_computer }}"
    keepassxc_db = "{{ $keepassxc_db }}"
{{- if eq $company_computer "y" }}
    work_git_host = "{{ $work_git_host }}"
{{- end }}
{{- range $key, $value := $install }}
    {{ $key }} = {{ $value }}
{{- end }}

{{ if ne $company_computer "y" -}}
[keepassxc]
    database = "{{ $keepassxc_db }}"
{{ end -}}
