#!/bin/sh

# Add general aliases or environment variables
# Neovim
alias vi="nvim"
alias vim="nvim"

# Code Insiders
alias ci='code-insiders'
alias l="ls -alh"
alias t="tree"
alias g="git"
alias h="history"

# File interactive
alias cp='cp -i'
alias mv='mv -i'
alias rm='rm -i'

# Easier navigation: .., ..., ...., ....., ~ and -
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."

{{ if eq .chezmoi.hostname "vagrant" -}}
# Add work specific aliases or environment variables
    #TODO: add docker to personal packages?
    # Docker
    alias dps="docker ps"
    alias dsa="docker stop $(docker ps -q)" # Stop all docker containers
    alias dcu="docker compose up -d"
    alias dcd="docker compose down"
    alias dcrs="docker compose down && docker compose up -d"
{{ end -}}

{{ if eq .chezmoi.username "tabula" -}}
# Add personal aliases or environment variables
    alias lg="lazygit"
{{ end -}}
