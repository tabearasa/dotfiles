#!/bin/sh

# Runs first (00_ prefix): the other install scripts rely on curl, git, unzip etc.
sudo apt-get update

# ========== Install Packages for Development ==========
{{ $dev_packages := list
    "tmux"
    "git"
    "gh"
    "make"
    "zsh"
    "fd-find"
    "tldr"
    "ripgrep"
    "jq"
    "direnv"
    "catimg"
    "pandoc"
    "unzip"
    "fontconfig"
-}}

sudo apt-get install -y {{$dev_packages | join " " }}

# https://github.com/pyenv/pyenv/wiki#suggested-build-environment
# ========== Install Build Dependencies for pyenv (compiling Python) ==========
{{ $pyenv_build_packages := list
    "build-essential"
    "libssl-dev"
    "zlib1g-dev"
    "libbz2-dev"
    "libreadline-dev"
    "libsqlite3-dev"
    "libncurses-dev"
    "xz-utils"
    "tk-dev"
    "libxml2-dev"
    "libxmlsec1-dev"
    "libffi-dev"
    "liblzma-dev"
-}}

sudo apt-get install -y {{ $pyenv_build_packages | join " " }}

# ========== Install Packages for Networking ===========
{{ $network_packages := list
    "ca-certificates"
    "curl"
    "wget"
    "gpg"
    "nmap"
    "mtr"
-}}

sudo apt-get install -y {{ $network_packages | join " " }}

# ========== Install Docker ==========
sudo apt-get install -y docker.io docker-compose
sudo usermod -aG docker "$USER"

# ========== Install Packages for Personal Machines Only ==========
{{ if ne .company_computer "y" -}}
sudo apt-get install -y keepassxc

# Optional apps, chosen via the install_* prompts at `chezmoi init` (.chezmoi.toml.tmpl)
{{ $optional_packages := list -}}
{{ range list "freecad" "blender" "kicad" "darktable" "btop" -}}
{{   if index $ (printf "install_%s" .) }}{{ $optional_packages = append $optional_packages . }}{{ end -}}
{{ end -}}
{{ if $optional_packages -}}
sudo apt-get install -y {{ $optional_packages | join " " }}
{{ end -}}

{{ if index . "install_brave" -}}
# Brave is not in the Debian repos: https://brave.com/linux/#debian-ubuntu-mint
sudo curl -fsSLo /usr/share/keyrings/brave-browser-archive-keyring.gpg https://brave-browser-apt-release.s3.brave.com/brave-browser-archive-keyring.gpg
sudo curl -fsSLo /etc/apt/sources.list.d/brave-browser-release.sources https://brave-browser-apt-release.s3.brave.com/brave-browser.sources
sudo apt-get update
sudo apt-get install -y brave-browser
{{ end -}}
{{- end }}
