#!/bin/sh

# ========== Install Packages for Development ==========
{{ $dev_packages := list
    "tmux"
    "git"
    "neovim"
    "zsh"
-}}

sudo apt-get install -y {{$dev_packages | join " " }}

# ========== Install Packages for Networking ===========
{{ $network_packages := list
    "ca-certificates"
    "curl"
    "wget"
    "gpg"
    "nmap"
    "mtr"
-}}


sudo apt-get install -y {{ $network_packages | join " " }}
