{{ if or (eq .chezmoi.osRelease.id "debian") (eq .chezmoi.osRelase.id "ubuntu")  -}}
# Template for debian/ubuntu based systems
#!/bin/sh

set -e pipefail

{{ $general_packages := list
    "tmux"
    "git"
    "neovim"
    "zsh"
    "ca-certificates"
    "curl"
-}}

# Install General packages for debian-based systems
sudo apt-get install -y {{$general_packages | join " " }}
{{ end -}}

#TODO: install docker (https://docs.docker.com/engine/install/debian/#install-from-a-package)

# Install Personal packages
{{ if eq .chezmoi.username "tabula" -}}

# Adding personal package sources list
{{ $personal_packages := list
    "spotify-client"
-}}

# Spotify
curl -sS https://download.spotify.com/debian/pubkey_5384CE82BA52C83A.asc | sudo gpg --dearmor --yes -o /etc/apt/trusted.gpg.d/spotify.gpg
echo "deb https://repository.spotify.com stable non-free" | sudo tee /etc/apt/sources.list.d/spotify.list
sudo apt-get update

# Install Personal packages for debian-based systems
sudo apt-get install -y {{$personal_packages | join " " }}

# Install Rust on personal machines
# https://doc.rust-lang.org/cargo/getting-started/installation.html
if [ ! command -v rustc >/dev/null 2>&1 ]; then
    curl https://sh.rustup.rs -sSf | sh
fi

# Install alacritty for personal debian-based systems
# https://github.com/alacritty/alacritty/blob/master/INSTALL.md
if [ ! -d "~/github/alacritty"]; then
    echo "test"
    git clone https://github.com/alacritty/alacritty.git
    cd alacritty
    # Dependencies
    sudo apt-get install -y cmake g++ pkg-config libfontconfig1-dev libxcb-xfixes0-dev libxkbcommon-dev python3
    cargo build --releaese
fi

# Install NVM
curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.4/install.sh | bash

# TODO: install obsidian
# requires fuse 2.x alongside 3.x on debian trixie system https://docs.appimage.org/user-guide/troubleshooting/fuse.html#ref-install-fuse
# otherwise install the appimage by downloading it
# run:
# chmod u+x Obsidian-<version>.AppImage
# ./Obsidian-<version>.AppImage --no-sandbox

