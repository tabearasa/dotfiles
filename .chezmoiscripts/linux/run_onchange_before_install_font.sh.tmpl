{{ if ne .company_computer "y" -}}
#!/usr/bin/env bash
set -euo pipefail

FONT_DIR="$HOME/.local/share/fonts"
FAVORITE_FONT="FiraCodeNerdFont"
FAVORITE_FONT_URL="https://github.com/ryanoasis/nerd-fonts/releases/latest/download/FiraCode.zip"

if fc-list "$FAVORITE_FONT" | grep -q .; then
    echo "FiraCode Nerd Font already installed, skipping."
    exit 0
fi

mkdir -p "$FONT_DIR"
curl -fLo /tmp/FiraCode.zip "$FAVORITE_FONT_URL"
unzip -o /tmp/FiraCode.zip -d "$FONT_DIR"
rm /tmp/FiraCode.zip
fc-cache -fv "$FONT_DIR"
{{ end -}}
