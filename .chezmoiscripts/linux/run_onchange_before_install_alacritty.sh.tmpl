#!/bin/sh
{{ if ne .company_computer "y" }}

# Install Rust to build alacritty
# https://doc.rust-lang.org/cargo/getting-started/installation.html
if ! command -v rustc >/dev/null 2>&1; then
    curl https://sh.rustup.rs -sSf | sh -s -- -y
fi
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# Install alacritty for personal debian-based systems
# https://github.com/alacritty/alacritty/blob/master/INSTALL.md
if [ ! -d "$HOME/github/alacritty" ]; then
    mkdir -p $HOME/github/
    cd $HOME/github
    git clone https://github.com/alacritty/alacritty.git
    cd alacritty
    # Dependencies
    sudo apt-get install -y cmake g++ pkg-config libfontconfig1-dev libxcb-xfixes0-dev libxkbcommon-dev python3
    cargo build --release
fi

# TODO: add a shortcut and an icon?
# sudo cp target/release/alacritty /usr/local/bin # or anywhere else in $PATH
# sudo cp extra/logo/alacritty-term.svg /usr/share/pixmaps/Alacritty.svg
# sudo desktop-file-install extra/linux/Alacritty.desktop
# sudo update-desktop-database
cd $HOME
{{ end }}
