# ~/.xsessionrc is only read by Debian's /etc/X11/Xsession (Debian/Ubuntu X11 logins)
{{ if not (stat "/etc/X11/Xsession") }}
.xsessionrc
{{ end }}

# Oh My Zsh writes its cache at runtime; the external is exact = true,
# so without this chezmoi would delete it on every apply
.oh-my-zsh/cache/**

# Work git identity only exists on company computers
{{ if ne .company_computer "y" }}
.gitconfig_work
{{ end }}
