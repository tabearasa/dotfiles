[user]
    # No global identity: git refuses to commit until a repo gets one,
    # so a wrong identity can't leak
    useConfigOnly = true

# Identity follows the remote URL, not the directory
[includeIf "hasconfig:remote.*.url:git@github.com:{{ .github_name }}/**"]
    path = "~/.gitconfig_personal"
[includeIf "hasconfig:remote.*.url:https://github.com/{{ .github_name }}/**"]
    path = "~/.gitconfig_personal"
{{- if eq .company_computer "y" }}
[includeIf "hasconfig:remote.*.url:git@{{ .work_git_host }}:**"]
    path = "~/.gitconfig_work"
[includeIf "hasconfig:remote.*.url:https://{{ .work_git_host }}/**"]
    path = "~/.gitconfig_work"
{{- end }}

[init]
    defaultBranch = main

[push]
    # `git push` on a new branch creates origin/<branch> and sets tracking, no -u needed
    autoSetupRemote = true
